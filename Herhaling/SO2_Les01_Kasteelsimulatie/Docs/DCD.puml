@startuml
title Softwareontwerp 2 - Les 1 | Kasteelsimulatie
skinparam monochrome true
skinparam classAttributeIconSize 0
hide empty members

class Raster {
  - _kastelen: List<Kasteel> [readonly]
  + Breedte: int [get; init]
  + Hoogte: int [get; init]
  + Kastelen: IReadOnlyList<Kasteel> [get]
  + Raster(breedte: int, hoogte: int)
  + Bevat(coordinate: Coordinate): bool
  + ZoekKasteelOp(positie: Coordinate): Kasteel?
  + VoegKasteelToe(kasteel: Kasteel): void
}

class Kasteel {
  - _bewoners: List<Bewoner> [readonly]
  + Positie: Coordinate [get; init]
  + Kleur: KasteelKleur [get; init]
  + AantalVlaggetjes: int [get; private set]
  + Bewoners: IReadOnlyList<Bewoner> [get]
  + Kasteel(positie: Coordinate, kleur: KasteelKleur, aantalVlaggetjes: int)
  + HangVlagBij(): void
  + VoegBewonerToe(bewoner: Bewoner): void
  + IsBewoond(): bool
}

class Coordinate {
  + X: int [get; init]
  + Y: int [get; init]
  + Coordinate(x: int, y: int)
}

enum KasteelKleur {
  Grijs
  Blauw
  Rood
}

abstract class Bewoner {
  + Naam: string [get; init]
  # Bewoner(naam: string)
}

class Prinses <<sealed>> {
  + Beschrijving: string [get; init]
  + Prinses(naam: string, beschrijving: string)
}

class Kok <<sealed>> {
  + Specialiteit: string [get; init]
  + Kok(naam: string, specialiteit: string)
}

class Ridder <<sealed>> {
  + ZwaardLengte: int [get; init]
  + Ridder(naam: string, zwaardLengte: int)
  + Strijd(): void
}

class Stalknecht <<sealed>> {
  + Stalknecht(naam: string)
  + Strijd(): void
}

interface IStrijder {
  + Strijd(): void
}

Raster --> "0..*" Kasteel : Kastelen
Kasteel --> "1" Coordinate : Positie
Kasteel --> "0..*" Bewoner : Bewoners
Kasteel ..> KasteelKleur : Kleur
Bewoner <|-- Prinses
Bewoner <|-- Kok
Bewoner <|-- Ridder
Bewoner <|-- Stalknecht
IStrijder <|.. Ridder
IStrijder <|.. Stalknecht

legend bottom
+ public   |   - private   |   # protected
[get; init]: alleen instellen tijdens constructie   |   [get; private set]: alleen de klasse kan later wijzigen
Pijl = navigatierichting; multipliciteit bij het doel. Geen exclusief eigenaarschap verondersteld.
Backingfields van properties niet herhaald; de private beheercollecties wel. Program is geen domeinklasse.
endlegend
@enduml
