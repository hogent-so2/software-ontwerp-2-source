digraph DCD {
graph [rankdir=TB, nodesep=0.48, ranksep=0.85, splines=polyline, pad=0.25, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Softwareontwerp 2 - Les 1 | Kasteelsimulatie"];
node [shape=plain, fontname="DejaVu Sans", fontsize=12];
edge [fontname="DejaVu Sans", fontsize=11, arrowsize=1.0, labeldistance=1.8];
Raster [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><B>Raster</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">- _kastelen: List&lt;Kasteel&gt; [readonly]<BR ALIGN="LEFT"/>+ Breedte: int [get; init]<BR ALIGN="LEFT"/>+ Hoogte: int [get; init]<BR ALIGN="LEFT"/>+ Kastelen: IReadOnlyList&lt;Kasteel&gt; [get]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Raster(breedte: int, hoogte: int)<BR ALIGN="LEFT"/>+ Bevat(coordinate: Coordinate): bool<BR ALIGN="LEFT"/>+ ZoekKasteelOp(positie: Coordinate): Kasteel?<BR ALIGN="LEFT"/>+ VoegKasteelToe(kasteel: Kasteel): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Kasteel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><B>Kasteel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">- _bewoners: List&lt;Bewoner&gt; [readonly]<BR ALIGN="LEFT"/>+ Positie: Coordinate [get; init]<BR ALIGN="LEFT"/>+ Kleur: KasteelKleur [get; init]<BR ALIGN="LEFT"/>+ AantalVlaggetjes: int [get; private set]<BR ALIGN="LEFT"/>+ Bewoners: IReadOnlyList&lt;Bewoner&gt; [get]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Kasteel(positie: Coordinate,<BR ALIGN="LEFT"/>    kleur: KasteelKleur, aantalVlaggetjes: int)<BR ALIGN="LEFT"/>+ HangVlagBij(): void<BR ALIGN="LEFT"/>+ VoegBewonerToe(bewoner: Bewoner): void<BR ALIGN="LEFT"/>+ IsBewoond(): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Coordinate [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><B>Coordinate</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ X: int [get; init]<BR ALIGN="LEFT"/>+ Y: int [get; init]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Coordinate(x: int, y: int)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
KasteelKleur [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="10">&lt;&lt;enum&gt;&gt;</FONT><BR/><B>KasteelKleur</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">Grijs<BR ALIGN="LEFT"/>Blauw<BR ALIGN="LEFT"/>Rood<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Bewoner [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="10">&lt;&lt;abstract&gt;&gt;</FONT><BR/><B>Bewoner</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Naam: string [get; init]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9"># Bewoner(naam: string)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Prinses [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="10">&lt;&lt;sealed&gt;&gt;</FONT><BR/><B>Prinses</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Beschrijving: string [get; init]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Prinses(naam: string, beschrijving: string)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Kok [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="10">&lt;&lt;sealed&gt;&gt;</FONT><BR/><B>Kok</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Specialiteit: string [get; init]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Kok(naam: string, specialiteit: string)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Ridder [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="10">&lt;&lt;sealed&gt;&gt;</FONT><BR/><B>Ridder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ ZwaardLengte: int [get; init]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Ridder(naam: string, zwaardLengte: int)<BR ALIGN="LEFT"/>+ Strijd(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Stalknecht [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="10">&lt;&lt;sealed&gt;&gt;</FONT><BR/><B>Stalknecht</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Stalknecht(naam: string)<BR ALIGN="LEFT"/>+ Strijd(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
IStrijder [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0"><TR><TD ALIGN="CENTER" BALIGN="CENTER" CELLPADDING="9"><FONT POINT-SIZE="10">&lt;&lt;interface&gt;&gt;</FONT><BR/><B>IStrijder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="9">+ Strijd(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
{rank=same; Coordinate; Kasteel; KasteelKleur;}
{rank=same; Bewoner; IStrijder;}
{rank=same; Prinses; Kok; Ridder; Stalknecht;}
Raster -> Kasteel [arrowhead=vee, label="Kastelen", headlabel="0..*", labelangle=50, labeldistance=1.8, constraint=true];
Kasteel -> Coordinate [arrowhead=vee, label="Positie", headlabel="1", labelangle=50, labeldistance=1.8, constraint=false];
Kasteel -> Bewoner [arrowhead=vee, label="Bewoners", headlabel="0..*", labelangle=50, labeldistance=1.8, constraint=true];
Kasteel -> KasteelKleur [style=dashed, arrowhead=vee, label="Kleur", constraint=false];
Bewoner -> Prinses [dir=back, arrowtail=empty, arrowhead=none];
Bewoner -> Kok [dir=back, arrowtail=empty, arrowhead=none];
Bewoner -> Ridder [dir=back, arrowtail=empty, arrowhead=none];
Bewoner -> Stalknecht [dir=back, arrowtail=empty, arrowhead=none];
IStrijder -> Ridder [style=dashed, dir=back, arrowtail=empty, arrowhead=none];
IStrijder -> Stalknecht [style=dashed, dir=back, arrowtail=empty, arrowhead=none];
Prinses -> Kok -> Ridder -> Stalknecht [style=invis, weight=50];
Legenda [shape=plain, fontsize=11, label="+ public   |   - private   |   # protected\n[get; init]: alleen instellen tijdens constructie   |   [get; private set]: alleen de klasse kan later wijzigen\nPijl = navigatierichting; multipliciteit bij het doel. Geen exclusief eigenaarschap verondersteld.\nBackingfields van properties niet herhaald; de private beheercollecties wel. Program is geen domeinklasse."];
Kok -> Legenda [style=invis];
Ridder -> Legenda [style=invis];
}
