<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JokeApp.MainPage"
             Title="JokeApp"
             Shell.NavBarIsVisible="False">

    <!-- Eén scrolbaar scherm, opgebouwd met de layouts en controls uit de les.
         De controls staan onder elkaar zodat het formulier ook op een smal scherm past. -->
    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="16"
                             MaximumWidthRequest="720"
                             HorizontalOptions="Fill">

            <Label Text="JokeApp"
                   FontSize="32"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Ontdek een grap of voeg er zelf één toe." />

            <Border Padding="20"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="12">
                    <!-- Ook bij een zelf toegevoegde of opnieuw getoonde grap
                         moeten tekst en categorie samen worden bijgewerkt. -->
                    <Label x:Name="CurrentJokeCategoryLabel"
                           Text="Nog geen grap gekozen"
                           FontSize="14"
                           FontAttributes="Bold" />
                    <Label x:Name="CurrentJokeLabel"
                           Text="Klik op de knop voor een grap."
                           FontSize="20"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Toon een willekeurige grap"
                    Clicked="ShowRandomJoke_Clicked" />

            <!-- Could: deze knop wordt pas bruikbaar na een willekeurige opvraag. -->
            <Button x:Name="ShowLastRandomJokeButton"
                    Text="Toon de laatste willekeurige grap opnieuw"
                    IsEnabled="False"
                    Clicked="ShowLastRandomJoke_Clicked" />

            <Label x:Name="RandomRequestCountLabel"
                   Text="Willekeurige grappen opgevraagd: 0"
                   FontSize="14" />

            <Label Text="Zelf een grap toevoegen"
                   FontSize="22"
                   FontAttributes="Bold"
                   Margin="0,12,0,0"
                   SemanticProperties.HeadingLevel="Level2" />

            <Label Text="Grap" />
            <Entry x:Name="JokeTextEntry"
                   Placeholder="Typ hier een grap"
                   ReturnType="Done"
                   SemanticProperties.Description="Tekst van de nieuwe grap"
                   TextChanged="JokeText_Changed"
                   Completed="JokeText_Completed" />

            <Label Text="Categorie" />
            <!-- ItemsSource en de beginselectie worden pas in de constructor
                 ingesteld, nadat InitializeComponent alle controls heeft aangemaakt. -->
            <Picker x:Name="CategoryPicker"
                    Title="Kies een categorie"
                    SemanticProperties.Description="Categorie voor de nieuwe grap"
                    SelectedIndexChanged="Category_SelectionChanged" />

            <!-- Should: dit beschrijft de invoer, niet de grap bovenaan het scherm. -->
            <Label x:Name="SelectedCategoryLabel"
                   Text="Nog geen categorie geselecteerd"
                   FontSize="14" />

            <Button x:Name="AddJokeButton"
                    Text="Toevoegen"
                    IsEnabled="False"
                    Clicked="AddJoke_Clicked" />

            <Button Text="Invoer wissen"
                    Clicked="ClearInput_Clicked" />

            <Label x:Name="FeedbackLabel"
                   Text=""
                   FontSize="14" />

            <!-- De actuele waarde komt uit JokeService; geen hardgecodeerd aantal. -->
            <Label x:Name="StatusLabel"
                   FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
